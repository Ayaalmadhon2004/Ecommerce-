    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "framer-motion": "^14.6.0",
    "react": "^19.1.1",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
